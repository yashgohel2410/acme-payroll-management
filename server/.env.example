# Relative paths are resolved from the server directory.
# On Render, mount a disk and use an absolute path on that disk, such as file:/var/data/payroll.db.
DATABASE_URL="file:./dev.db"
PORT=5000
NODE_ENV=development
# Comma-separated browser origins. Use http://localhost:5173 for the Vite client.
CORS_ORIGIN="http://localhost:5173"